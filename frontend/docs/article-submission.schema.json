{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CREN staged article submission",
  "type": "object",
  "required": [
    "prompt_version",
    "title",
    "category",
    "author",
    "date",
    "excerpt",
    "body",
    "answer_summary",
    "primary_keyword",
    "meta_description",
    "fact_checked_at",
    "canonical_event_key",
    "tags",
    "location",
    "source_ledger",
    "claim_ledger",
    "entity_ledger",
    "image_brief",
    "image_alt",
    "image_provenance"
  ],
  "properties": {
    "prompt_version": { "enum": ["cren-article-v1.0.0", "cren-article-v1.0.1", "cren-article-v1.0.2"] },
    "title": { "type": "string", "minLength": 45, "maxLength": 75 },
    "category": { "type": "string" },
    "author": { "type": "string" },
    "date": { "type": "string" },
    "excerpt": { "type": "string", "minLength": 140, "maxLength": 165 },
    "body": { "type": "string", "minLength": 1800, "description": "Publication-ready Markdown of at least 350 words. The first paragraph must exactly equal answer_summary, at least two independent ledger sources must be linked inline, and raw citation tokens are prohibited." },
    "answer_summary": { "type": "string", "description": "30–60 words and no more than two sentences." },
    "primary_keyword": { "type": "string" },
    "meta_description": { "type": "string", "minLength": 140, "maxLength": 165 },
    "fact_checked_at": { "type": "string", "format": "date-time" },
    "canonical_event_key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
    "area_slug": { "type": ["string", "null"] },
    "topic_slug": {
      "type": ["string", "null"],
      "enum": ["market-trends", "schools", "development", "local-politics", "events-lifestyle", null]
    },
    "tags": {
      "type": "array",
      "minItems": 3,
      "maxItems": 7,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "read_time": { "type": "string" },
    "featured": { "type": "boolean" },
    "image_url": { "type": ["string", "null"] },
    "location": {
      "type": "object",
      "required": ["name", "state"],
      "properties": {
        "name": { "type": "string" },
        "state": { "const": "OH" }
      }
    },
    "source_ledger": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "type", "url", "publisher", "title", "fetched_at", "http_status"],
        "properties": {
          "id": { "type": "string" },
          "type": { "enum": ["PRIMARY", "SECONDARY"], "description": "PRIMARY means the originating record, dataset, filing, direct interview, or first-party statement about the issuer's own action. Journalism, trade coverage, broker blogs, aggregators, and rewritten announcements are SECONDARY." },
          "url": { "type": "string", "format": "uri" },
          "publisher": { "type": "string" },
          "title": { "type": "string" },
          "published_at": { "type": ["string", "null"] },
          "fetched_at": { "type": "string", "format": "date-time" },
          "http_status": { "type": "integer", "minimum": 200, "maximum": 399 }
        }
      }
    },
    "claim_ledger": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "claim", "source_ids"],
        "properties": {
          "id": { "type": "string" },
          "claim": { "type": "string", "description": "Exact sentence as it appears in body." },
          "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "kind": { "enum": ["FACT", "QUOTE", "CALCULATION", "STATUS", "COMPARISON"] },
          "exact_support": { "type": "string", "description": "Required for direct quotes; 25 words maximum." },
          "calculation": { "type": "string" }
        }
      }
    },
    "entity_ledger": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "source_ids"],
        "properties": {
          "name": { "type": "string" },
          "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "image_brief": {
      "type": "object",
      "required": ["primary_request", "editorial_idea", "story_anchors", "source_asset_considered", "avoid"],
      "properties": {
        "primary_request": { "type": "string" },
        "editorial_idea": { "type": "string" },
        "story_anchors": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": { "type": "string" }
        },
        "source_asset_considered": { "const": true },
        "source_asset_note": { "type": "string" },
        "image_policy_version": { "const": "cren-image-v2-real-photo-first" },
        "image_role": {
          "enum": ["SUBJECT", "CONTEXT", "DATA"],
          "description": "SUBJECT shows the story site itself; CONTEXT is an honest, dated photo of the surrounding area; DATA is a chart or map built from public data."
        },
        "source_review": {
          "type": "array", "minItems": 1, "maxItems": 10,
          "items": {
            "type": "object", "required": ["url", "outcome", "note"],
            "properties": {
              "url": { "type": "string", "format": "uri" },
              "outcome": { "enum": ["SELECTED", "UNAVAILABLE", "RIGHTS_UNCLEAR", "UNSUITABLE"] },
              "note": { "type": "string", "minLength": 1 }
            }
          }
        },
        "avoid": { "type": "string" }
      }
    },
    "image_alt": { "type": "string", "minLength": 40, "maxLength": 160 },
    "cloud_image_asset": {
      "type": "object",
      "description": "Required for cloud source-photo imports; exact original bytes at the server-pinned GitHub commit, not an arbitrary URL.",
      "required": ["path", "git_blob_sha", "source_sha256", "visual_review"],
      "properties": {
        "path": { "type": "string", "pattern": "^frontend/content/images/[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+\\.(jpg|jpeg|png|webp)$" },
        "git_blob_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "visual_review": {
          "type": "object",
          "required": ["reviewed_by", "reviewed_at", "natural_appearance", "geometry_and_shadows", "no_synthetic_artifacts", "story_match", "truthful_caption", "mobile_crop"],
          "properties": {
            "reviewed_by": { "type": "string", "minLength": 1 },
            "reviewed_at": { "type": "string", "format": "date-time" },
            "natural_appearance": { "const": true }, "geometry_and_shadows": { "const": true },
            "no_synthetic_artifacts": { "const": true }, "story_match": { "const": true },
            "truthful_caption": { "const": true }, "mobile_crop": { "const": true }
          }
        }
      }
    },
    "image_provenance": {
      "type": "object",
      "required": ["type", "caption"],
      "properties": {
        "type": {
          "enum": [
            "AI_GENERATED",
            "LICENSED_PHOTO",
            "OFFICIAL_RENDERING",
            "PUBLIC_RECORD_GRAPHIC",
            "CREN_GRAPHIC"
          ]
        },
        "caption": { "type": "string" },
        "source": { "type": "string" },
        "license": { "type": "string" },
        "permission_evidence": { "type": "string" },
        "credit": { "type": "string" },
        "location_note": { "type": "string" },
        "date_note": { "type": "string" },
        "verified_by": { "type": "string" },
        "verified_at": { "type": "string", "format": "date-time" }
      }
    }
  },
  "allOf": [{
    "if": { "properties": { "prompt_version": { "const": "cren-article-v1.0.2" } } },
    "then": { "properties": {
      "image_brief": { "required": ["image_policy_version", "source_review", "source_asset_note"] },
      "image_provenance": {
        "if": { "properties": { "type": { "const": "AI_GENERATED" } } },
        "then": { "properties": { "caption": { "const": "AI-generated illustration; not a photograph of the actual property or event." } } },
        "else": { "required": ["source", "license", "permission_evidence", "credit", "location_note", "date_note", "verified_by", "verified_at"] }
      }
    } }
  }]
}
