DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
ADMIN_JWT_SECRET=
# Prefer a separate member key. Admin verification also enforces admin role and claims.
MEMBER_JWT_SECRET=
ADMIN_DEFAULT_PASSWORD=
ADMIN_INIT_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Resend email transport (lead replies, owner notifications, CRM sequences).
# Verify the sending domain at resend.com/domains before setting the key.
RESEND_API_KEY=
# Verified sender; defaults to "Columbus Real Estate News <editor@columbusrealestatenews.com>"
RESEND_FROM_EMAIL=
# Where new-inquiry notifications go; defaults to editor@columbusrealestatenews.com
LEAD_NOTIFY_EMAIL=
# Reply-To on outbound mail so answers land in a monitored inbox
EMAIL_REPLY_TO=

# Email-based editorial proof and revision loop.
CREN_EDITOR_REVIEW_EMAIL=
CREN_EDITOR_REVIEW_DOMAIN=review.columbusrealestatenews.com
RESEND_EDITORIAL_WEBHOOK_SECRET=
RESEND_RECEIVING_API_KEY=
CRON_SECRET=
CREN_CLOUD_IMAGES_ENABLED=false
CREN_IMAGE_MODEL=openai/gpt-image-2
CREN_OPENAI_IMAGE_MODEL=gpt-image-1
NEWSROOM_IMAGE_SERVICE_URL=
NEWSROOM_IMAGE_SERVICE_SECRET=
NEWSROOM_CREN_TRIGGER_SECRET=
# Newsroom health thresholds. Defaults shown here match the scheduled audit.
CREN_MAX_RUN_AGE_HOURS=36
CREN_MAX_DRAFT_AGE_HOURS=24
CREN_MAX_NO_PUBLICATION_HOURS=72

# Additive September 2026 security migration is required before this release.
# Register the real apex/www hosts with Turnstile; tokens are checked server-side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAMES=columbusrealestatenews.com,www.columbusrealestatenews.com
# Generate independently; >=32 characters. Never reuse a caller or admin token.
INTAKE_HASH_SECRET=
INTAKE_PUBLIC_ORIGIN=https://www.columbusrealestatenews.com
# Owner confirmed CREN; the service is distinct from CREN editorial/newsletter consent.
CREN_ACQUISITION_ENTITY_NAME=CREN
NEXT_PUBLIC_CREN_ACQUISITION_ENTITY_NAME=CREN
# Names alone never activate the funnel. Enable only after the separate CRM receiver is ready.
CREN_ACQUISITION_INTAKE_ENABLED=false
NEXT_PUBLIC_CREN_ACQUISITION_INTAKE_ENABLED=false

# Durable operations. Require migrations, deployment approval and canaries before enabling.
CREN_OPERATIONS_ENABLED=false
CREN_CADENCE_ENABLED=false
CREN_OPERATIONS_MAX_AGE_MINUTES=150
CRM_SYNC_ENABLED=false
CRM_SYNC_URL=
CRM_SYNC_SECRET=
# Acquisition deliveries remain held until the receiver has a separate pipeline.

# Optional bounded correction adapter. Keep scheduled revisions/proof sends disabled until approved.
AI_GATEWAY_API_KEY=
CREN_EDITORIAL_REVISION_MODEL=
CREN_EDITORIAL_CORRECTIONS_ENABLED=false
CREN_EDITORIAL_PROOFS_ENABLED=false
## Cloud-only draft handoff (public GitHub data; no GitHub/Claude database credential required)
CREN_CLOUD_IMPORT_ENABLED=false
# Paid image generation is a separate, explicitly approved opt-in; sourced photos need no model.
CREN_CLOUD_AI_IMAGES_ENABLED=false
