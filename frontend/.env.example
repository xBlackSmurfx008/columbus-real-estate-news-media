TELEGRAM_CHAT_ID=
# Resend email transport (lead replies, owner notifications, CRM sequences).
# Verify the sending domain at resend.com/domains before setting the key.
RESEND_API_KEY=
# Verified sender; defaults to "Columbus Real Estate News <editor@columbusrealestatenews.com>"
RESEND_FROM_EMAIL=
# Where new-inquiry notifications go; defaults to editor@columbusrealestatenews.com
LEAD_NOTIFY_EMAIL=
# Reply-To on outbound mail so answers land in a monitored inbox
EMAIL_REPLY_TO=

# Email-based editorial proof and revision loop.
CREN_EDITOR_REVIEW_EMAIL=
CREN_EDITOR_REVIEW_DOMAIN=review.columbusrealestatenews.com
RESEND_EDITORIAL_WEBHOOK_SECRET=
RESEND_RECEIVING_API_KEY=
CRON_SECRET=
CREN_CLOUD_IMAGES_ENABLED=false
CREN_IMAGE_MODEL=openai/gpt-image-2
CREN_OPENAI_IMAGE_MODEL=gpt-image-1
NEWSROOM_IMAGE_SERVICE_URL=
NEWSROOM_IMAGE_SERVICE_SECRET=
NEWSROOM_CREN_TRIGGER_SECRET=
# Newsroom health thresholds. Defaults shown here match the scheduled audit.
CREN_MAX_RUN_AGE_HOURS=36
CREN_MAX_DRAFT_AGE_HOURS=24
CREN_MAX_NO_PUBLICATION_HOURS=72
